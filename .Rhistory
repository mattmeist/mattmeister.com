group_by(strategy) |>
summarise(abs_error = mean(abs_error, na.rm = T))
df |>
group_by(bracket, strategy) |>
summarise(abs_error = mean(abs_error, na.rm = T))
df |>
group_by(prior_knowledge, strategy) |>
summarise(abs_error = mean(abs_error, na.rm = T))
